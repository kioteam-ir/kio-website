# =============================================================================
# KIO — local development (.env)
# =============================================================================
# Copy:  cp .env.local.example .env
# Use with compose dev + infra (see README → Local development).

# --- Backend ---
DEBUG=true
SECRET_KEY=dev-only-not-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_EXPIRE_DAYS=7
PASSWORD_HASH_ITERATIONS=100000

# Compose service names (db/redis from docker-compose.infra.yml)
DB_HOST=db
DB_PORT=5432
DB_USER=kio
DB_PASSWORD=change-me
DB_NAME=kio

REDIS_HOST=redis
REDIS_PORT=6379
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RATE=1.0
RATE_LIMIT_CAPACITY=10

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CRUDADMIN_USERNAME=admin
CRUDADMIN_PASSWORD=change-me
CRUDADMIN_ENABLED=true

# --- Frontend (Vite dev server) ---
VITE_API_URL=http://localhost:8000

# --- Host ports exposed by compose/docker-compose.dev.yml ---
API_PORT=8000
WEB_PORT=5173
DB_PORT=5432
REDIS_PORT=6379

ADMIN_DEV_EMAIL=change
ADMIN_DEV_PASSWORD=cnage