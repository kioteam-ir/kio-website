# =============================================================================
# KIO — staging / production (.env)
# =============================================================================
# Copy:  cp .env.deploy.example .env
# Replace every change-me value before deploy (see README → Deploy).

# --- Backend ---
DEBUG=false
SECRET_KEY=change-me-generate-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_EXPIRE_DAYS=7
PASSWORD_HASH_ITERATIONS=100000

# Use compose service name "db" when running postgres via compose.infra.yml,
# or set to your managed database hostname.
DB_HOST=db
DB_PORT=5432
DB_USER=kio
DB_PASSWORD=change-me-strong-db-password
DB_NAME=kio

# Use compose service name "redis" or an external Redis host.
REDIS_HOST=redis
REDIS_PORT=6379
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RATE=1.0
RATE_LIMIT_CAPACITY=10

# Public site origin(s) — comma-separated.
CORS_ORIGINS=https://example.com,https://www.example.com

CRUDADMIN_USERNAME=admin
CRUDADMIN_PASSWORD=change-me-strong-admin-password
CRUDADMIN_ENABLED=true

# Public API URL (baked into the production frontend image at build time).
VITE_API_URL=https://api.example.com

# Host ports when compose publishes services (staging typically exposes these).
API_PORT=8000
WEB_PORT=8080
