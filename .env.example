# =============================================================================
# KIO — shared environment (used by compose from repository root)
# =============================================================================

# --- Backend (API) ---
DEBUG=false
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_EXPIRE_DAYS=7
PASSWORD_HASH_ITERATIONS=100000

# Point to compose infra service names, or external hosts on another server
DB_HOST=db
DB_PORT=5432
DB_USER=kio
DB_PASSWORD=change-me
DB_NAME=kio

REDIS_HOST=redis
REDIS_PORT=6379
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RATE=1.0
RATE_LIMIT_CAPACITY=10

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CRUDADMIN_USERNAME=admin
CRUDADMIN_PASSWORD=change-me
CRUDADMIN_ENABLED=true

# --- Frontend (build-time for production image) ---
VITE_API_URL=http://localhost:8000

# --- Compose host ports (dev/staging) ---
API_PORT=8000
WEB_PORT=5173
