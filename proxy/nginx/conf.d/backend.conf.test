# Website backend / API - served from api.kioteam.ir
# Point this at your actual backend service: a container name on the
# shared "kioteam_network" (e.g. "backend:4000"), or a host/IP:port
# if it runs elsewhere (e.g. "192.168.1.10:4000").

upstream backend_upstream {
    server backend:8000;
}

server {
    listen 80;
    listen [::]:80;
    server_name api.kioteam.ir;

    limit_req zone=general_limit burst=20 nodelay;

    access_log /var/log/nginx/backend.access.log main;
    error_log  /var/log/nginx/backend.error.log;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://backend_upstream;
        include /etc/nginx/snippets/proxy-params.conf;
    }
}
